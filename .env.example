# Environment configuration.
#
# Production: these are Worker secrets, set once with
#   npx wrangler secret put ADMIN_PASSWORD
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put YOCO_SECRET_KEY
# (or Cloudflare dashboard -> Workers & Pages -> persuasive -> Settings -> Variables).
#
# Local: copy the three server-side keys to .dev.vars (read by `wrangler dev`)
# and VITE_YOCO_PUBLIC_KEY to .env.local (read by Vite). Do NOT quote values.
# Restart wrangler dev / vite after editing.

# Admin gate. Also sent by the admin site as an x-admin-password header on
# every admin API call.
ADMIN_PASSWORD=

# Resend transactional email
RESEND_API_KEY=

# Yoco hosted checkout — server side
YOCO_SECRET_KEY=

# Yoco client key. Build-time: set it under the Workers Build settings
# -> Variables in the Cloudflare dashboard, not as a Worker secret.
VITE_YOCO_PUBLIC_KEY=

# D1 (stock, orders, ambassadors, commission ledger) is a binding declared in
# wrangler.jsonc — no account ID, database ID or API token needed here.
